{
  "name": "Quick Preview for Soundcloud",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Just Hover the \u25b6\ufe0f Button to Preview Music on Soundcloud",
  "homepage_url": "https://mattias.lol",
  "author": "Mattias Hemmingsson",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en",
  "permissions": [
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "css": [
        "inject/inject.css"
      ]
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "inject/sentinel.min.js"
      ]
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "inject/inject.js"
      ]
    }
  ],
  "action": {
    "default_icon": "icons/icon32.png",
    "default_title": "Quick Preview for Soundcloud",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://soundcloud.com/*"
  ]
}
